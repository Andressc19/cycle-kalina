    if 'otra_ubicacion' in m: return 'otra_ubicacion'
    return 'no_identificada'
df['fam'] = df.mensaje.apply(fam)
print(df.fam.value_counts().to_string())
print()
print('nulos en eta/Wnet:', df.eta.isna().sum(), '/', df.Wnet.isna().sum())
