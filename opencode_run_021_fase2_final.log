import importlib.util, sys, time
from concurrent.futures import ProcessPoolExecutor
from pathlib import Path

CARPETA = Path(r"D:\Desktop\ciclo_kalina_tercero\.claude\worktrees\barridos-tercero-f7448d\scripts\barridos_2026-09-19\fase2_libre")
RAIZ = CARPETA.parents[2]
sys.path.insert(0, str(RAIZ)); sys.path.insert(0, str(CARPETA))

spec = importlib.util.spec_from_file_location("comun_sensibilidad", CARPETA / "comun_sensibilidad.py")
comun = importlib.util.module_from_spec(spec)
spec.loader.exec_module(comun)
sys.modules.setdefault("comun_sensibilidad", comun)

ANCLA = dict(P_alta=3000.0, P_baja=400.0, x_b=0.40, T_fuente=470.0,
             T_sumidero=300.032917, m_b=1.0, eta_t=0.85, eta_p=0.75,
             eps_hrvg=0.85, eps_reg=0.75, eps_cond=0.95)
combo2 = dict(ANCLA, P_baja=420.0)

def main():
    t0 = time.perf_counter()
    with ProcessPoolExecutor(max_workers=2) as pool:
        res = list(pool.map(comun.resolver_punto, [ANCLA, combo2]))
    for f in res:
        print(f"P_baja={f['P_baja']} -> {f['clasificacion']} eta={f['eta']} "
              f"ligante={f['criterio_ligante']} margen={f['margen_ligante']} "
              f"O2={f['margen_O2']}")
    print(f"2 puntos en {time.perf_counter()-t0:.0f} s")

if __name__ == "__main__":
    main()
