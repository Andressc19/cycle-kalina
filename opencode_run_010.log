El par retornado por `pure_VLE_T` parece ser densidades (rhoL, rhoV) de saturación, y cuadran con NH3 (índice 0). Lo verifico contra CoolProp y determino la semántica de `get_pr`:
[0m$ [0mpython - <<'EOF'
import numpy as np, teqp
import CoolProp.CoolProp as CP
m = teqp.AmmoniaWaterTillnerRoth()

# Densidades de saturacion de NH3 y H2O via CoolProp, para comparar con pure_VLE_T
for fld, T in [('Ammonia', 240.0), ('Ammonia', 373.15), ('Water', 373.15)]:
    rhoL = CP.PropsSI('DMOLAR', 'T', T, 'Q', 0, fld)   # mol/m3
    rhoV = CP.PropsSI('DMOLAR', 'T', T, 'Q', 1, fld)
    print(f'{fld} sat dens @ {T} K: rhoL={rhoL:.1f} rhoV={rhoV:.4f} mol/m3')

# pure_VLE_T retorna? verificar contra get_pr: rhoV de [1,0]@373.15 = 3295
r = m.pure_VLE_T(373.15, 30000.0, 10.0, 500, np.array([1.0, 0.0]))
print('pure_VLE_T(373.15,[1,0]) ->', r)
print('get_pr(373.15, [3295, 0]):', m.get_pr(373.15, np.array([3295.12833637, 0.0])))
print('NH3 Psat CoolProp@373.15:', CP.PropsSI('P','T',373.15,'Q',0,'Ammonia'))
print('get_pr(500, [1000, 0]):', m.get_pr(500.0, np.array([1000.0, 0.0])))
print('get_pr(500, [0, 1000]):', m.get_pr(500.0, np.array([0.0, 1000.0])))
print('IG P = R*T*rho =', 8.314471*500.0*1000.0)
