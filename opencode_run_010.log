    print(f'   compL={compL:.4f} compV={compV:.4f} | P(L)={P_tot(T,rl)/1e6:.4f} P(V)={P_tot(T,rv)/1e6:.4f} MPa')
    par = kf.flash_TP(T, P_MPa)
    print(f'   motor: xL={par[0]:.4f} xV={par[1]:.4f}')
