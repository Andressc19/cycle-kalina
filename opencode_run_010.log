[0m$ [0mpython - <<'EOF'
import numpy as np, teqp, json, sys
from CoolProp.CoolProp import PropsSI
sys.path.insert(0, r'D:\Desktop\ciclo_kalina_tercero')
from src.properties import _nh3h2o_engine as ng
import CoolProp.CoolProp as CP

m = teqp.AmmoniaWaterTillnerRoth()
R = m.get_R(np.array([0.5,0.5]))   # 8.314471
jn = json.loads(CP.get_fluid_param_string('Ammonia','JSON')); jw = json.loads(CP.get_fluid_param_string('Water','JSON'))
aig = teqp.IdealHelmholtz([teqp.convert_CoolProp_idealgas(json.dumps(jn[0]), 0),
                           teqp.convert_CoolProp_idealgas(json.dumps(jw[0]), 0)])
z = np.array([0.5, 0.5])

def alpha(T, rho):
    return float(m.get_Ar00(T, rho, z)) + float(aig.get_Aig00(T, rho, z))

def P_rho(T, rho):
    return float(m.get_pr(T, z*rho)) + R*T*rho

# estado liquido y vapor (densidades del motor)
for (T, P, x, ph) in [(450.0, 3.0, 0.5, 'l'), (450.0, 3.0, 0.5, 'v')]:
    rho = ng.rho_TPx(T, P, x, ph)*1000.0   # mol/m3
    # derivada numerica d alpha/dT a rho cte
    dT = 0.5
    a_p, a_m = alpha(T+dT, rho), alpha(T-dT, rho)
    dalpha_dT = (a_p - a_m)/(2*dT)
    u_RT_term = 1.0/T * 0.0  # placeholder
    # u = R*T**2 * dalpha/dT  (porque A = R*T*alpha, u = -T d(A/T)/dT = R*T^2 dalpha/dT)
    u = R*T*T*dalpha_dT
    h_num = u + P_rho(T,rho)/rho
    s_num = -R*(alpha(T,rho) + T*dalpha_dT)
    # candidatas con indices teqp
    h_cand1 = R*T*(1.0 + float(m.get_Ar01(T,rho,z)) + float(aig.get_Aig01(T,rho,z)))
    h_cand2 = R*T*(1.0 + float(m.get_Ar10(T,rho,z)) + float(aig.get_Aig10(T,rho,z)))
    s1 = R*(float(m.get_Ar10(T,rho,z)) + float(aig.get_Aig10(T,rho,z)) - (float(m.get_Ar00(T,rho,z)) + float(aig.get_Aig00(T,rho,z))))
    print(f'--- {ph} T={T} P={P} x={x} rho={rho:.0f}')
    print(f'  h numerica  = {h_num/1000:.3f} kJ/mol   s numerica = {s_num:.6f} J/mol/K')
    print(f'  h cand Ar01(+Aig01) = {h_cand1/1000:.3f} kJ/mol   h cand Ar10(+Aig10) = {h_cand2/1000:.3f}')
    print(f'  s cand (Aig10+Ar10 - total00) = {s1:.6f}')
    eng = ng.prop(rho/1000.0, T, 0.5)
    print(f'  motor: h={eng["h"]:.3f} kJ/kg  s={eng["s"]:.6f} kJ/kg/K   (M_mix={0.5*17.031+0.5*18.015:.4f})')
