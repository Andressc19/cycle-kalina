import numpy as np, teqp, sys
sys.path.insert(0, r'D:\Desktop\ciclo_kalina_tercero')
from src.properties import _nh3h2o_engine as ng
m = teqp.AmmoniaWaterTillnerRoth()
z = np.array([0.5, 0.5])
R = m.get_R(z)
def P_tot(T, rhovec):
    return R*T*rhovec.sum() + m.get_pr(T, rhovec)

def seed_puro_NH3(T):
    """Semilla oficial: densidades de saturacion del NH3 puro via pure_VLE_T, escaladas por z."""
    rhoL, rhoV = m.pure_VLE_T(T, 40000.0, 20.0, 500, np.array([1.0, 0.0]))
    return rhoL, rhoV

print('== mix_VLE_Tx con semillas "puro NH3 escalado" ==')
for T in [360.0, 420.0, 480.0]:
    try:
        rhoL, rhoV = seed_puro_NH3(T)
        rhovecL0 = z*rhoL; rhovecV0 = z*rhoV
        out = m.mix_VLE_Tx(T, rhovecL0, rhovecV0, z, 1e-10, 1e-10, 1e-10, 1e-10, 100)
        code, rL, rV = str(out[0]), out[1], out[2]
        PL = P_tot(T, rL)/1e6
        print(f'T={T}: code={code} P_bub={PL:.4f} MPa y={rV/rV.sum():.4f} rhoL={rL.sum():.0f} rhoV={rV.sum():.0f}')
    except Exception as e:
        print(f'T={T}: fallo {str(e)[:120]}')

print()
print('== mixture_VLE_px (burbuja y rocio directos) ==')
# motor de referencia
Tb, yb, _ = ng.bubbleT(3.0, 0.5); Td, xd, _ = ng.dewT(3.0, 0.5)
print(f'motor: bubbleT(3MPa,0.5)={Tb:.4f} K (esp y={yb:.4f}); dewT(3MPa,0.5)={Td:.4f} K (esp xL={xd:.4f})')
for p, T0 in [(3.0e6, 450.0), (0.4e6, 350.0)]:
    for label, xspec in [('bub(z=0.5)', z)]:
        try:
            r = m.mixture_VLE_px(p, xspec, T0, z*30000.0, z*500.0, None)
            print(f'P={p/1e6:.1f} MPa {label}: code={r[0]} T_sol={r[1]:.4f} K')
            rL, rV = r[2], r[3]
            print(f'    compL={rL/rL.sum():.4f} compV={rV/rV.sum():.4f} P(L)={P_tot(r[1],rL)/1e6:.4f} P(V)={P_tot(r[1],rV)/1e6:.4f} MPa')
        except Exception as e:
            print(f'P={p/1e6:.1f} MPa {label}: fallo {str(e)[:150]}')
