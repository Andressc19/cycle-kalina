[0m$ [0mpython - <<'EOF'
import numpy as np, teqp
m = teqp.AmmoniaWaterTillnerRoth()
z = np.array([0.5, 0.5])
R = m.get_R(z)
def P_tot(T, rhovec):
    return R*T*rhovec.sum() + m.get_pr(T, rhovec)

T = 360.0
# Motor: P_bub=1.6953 MPa, y=0.9841
print('Buscando semillas que converjan al punto de burbuja real (P=1.695 MPa, y=0.9841, rhoL=43700, rhoV~610):')
for rL in [40000.0, 42000.0, 44000.0, 45000.0, 48000.0, 55000.0]:
    for rV in [100.0, 300.0, 500.0, 700.0]:
        out = m.mix_VLE_Tx(T, z*rL, z*rV, z, 1e-10, 1e-10, 1e-10, 1e-10, 400)
        code = str(out[0])
        if 'xtol' not in code:
            continue
        rLc, rVc = out[1], out[2]
        PL, PV = P_tot(T, rLc)/1e6, P_tot(T, rVc)/1e6
        y = rVc/rVc.sum()
        print(f'  rhoL0={rL:.0f} rhoV0={rV:.0f}: code={code} | P={PL:.4f} MPa y={y[0]:.4f} | rhoL={rLc.sum():.0f} rhoV={rVc.sum():.0f}')
