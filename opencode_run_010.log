Fórmula de presión total confirmada (Pc NH3: 11.339 vs 11.333 MPa; saturaciones reproducidas). El flash no converge con semillas crudas. Desarrollo semillas mejor y pruebo `mix_VLE_Tx` contra el motor:
[0m$ [0mpython - <<'EOF'
import numpy as np, teqp, CoolProp.CoolProp as CP
m = teqp.AmmoniaWaterTillnerRoth()
R = m.get_R(np.array([0.5,0.5]))

def P_total(T, rhovec):
    return R*T*rhovec.sum() + m.get_pr(T, rhovec)

# get_reducing_density / get_rhor
z = np.array([0.5, 0.5])
try:
    print('get_reducing_density([1,0]):', m.get_reducing_density(np.array([1.0,0.0])))
    print('get_reducing_density([0.5,0.5]):', m.get_reducing_density(z))
except Exception as e:
    print('get_reducing_density fallo:', str(e)[:150])

# Densidades de saturacion puras CoolProp para semillas
def rhoL_pure(T, fld, Tc, rhoc):
    try:
        return CP.PropsSI('DMOLAR','T',T,'Q',0,fld)
    except Exception:
        return rhoc
def rhoV_pure(T, fld):
    try:
        return CP.PropsSI('DMOLAR','T',T,'Q',1,fld)
    except Exception:
        return 1.0

for (T, P_MPa) in [(420.0, 3.0), (360.0, 0.4), (480.0, 3.0)]:
    rhoL = z[0]*rhoL_pure(T,'Ammonia',405.4,13211.8) + z[1]*rhoL_pure(T,'Water',647.1,17873.7)
    rhoV = z[0]*rhoV_pure(T,'Ammonia') + z[1]*rhoV_pure(T,'Water')
    rhoV0 = max(rhoV, P_MPa*1e6/(R*T)*0.9)
    rhovecL0, rhovecV0 = z*rhoL, z*rhoV0
    out = m.mix_VLE_Tx(T, rhovecL0, rhovecV0, z, 1e-10, 1e-10, 1e-10, 1e-10, 400)
    code, rL, rV = out[0], out[1], out[2]
    print(f'T={T} z=0.5 code={code}')
    print(f'  compL={rL/rL.sum()} compV={rV/rV.sum()}')
    print(f'  P(L)={P_total(T,rL)/1e6:.4f} MPa  P(V)={P_total(T,rV)/1e6:.4f} MPa')
