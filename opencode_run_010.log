import numpy as np, teqp, sys
sys.path.insert(0, r'D:\Desktop\ciclo_kalina_tercero')
from src.properties import _nh3h2o_engine as ng
m = teqp.AmmoniaWaterTillnerRoth()
z = np.array([0.5, 0.5])
R = m.get_R(z)
def P_tot(T, rhovec):
    return R*T*float(rhovec.sum()) + float(m.get_pr(T, rhovec))

# mix_VLE_Tp: flash a (T, P) fijos
def flash_Tp(T, P_Pa, seedL, seedV):
    fl = teqp.MixVLETpFlags()
    r = m.mix_VLE_Tp(T, P_Pa, seedL, seedV, fl)
    return r

# Motor de referencia: flash_TP(T,P) molar -> (xL, xV)
for (T, P_MPa) in [(420.0, 3.0), (360.0, 1.6953), (420.0, 0.83)]:
    par = ng.flash_TP(T, P_MPa)
    print(f'Motor flash_TP({T},{P_MPa}):', par)

# teqp mix_VLE_Tp con seeds
fl = teqp.MixVLETpFlags()
for (T, P_MPa) in [(420.0, 3.0), (360.0, 1.6953)]:
    r = m.mix_VLE_Tp(T, P_MPa*1e6, z*40000.0, z*800.0, fl)
    print(f'teqp flash_Tp({T},{P_MPa}): rhoL={r.rhoL} rhoV={r.rhoV}')
    print('   iter:', r.iter, ' message?', dir(r))
    rl, rv = np.array(r.rhoL), np.array(r.rhoV)
    print(f'   compL={float(rl[0]/rl.sum()):.4f} compV={float(rv[0]/rv.sum()):.4f} P(L)={P_tot(T, rl)/1e6:.4f} P(V)={P_tot(T, rv)/1e6:.4f}')
