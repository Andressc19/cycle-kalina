import sys, numpy as np
sys.path.insert(0, r'D:\Desktop\ciclo_kalina_tercero')
from src.properties import _teqp_prototipo as tp
from CoolProp.CoolProp import PropsSI
from src.properties import _nh3h2o_engine as ng

P_MPa = 3.0
T = PropsSI('T','P',P_MPa*1e6,'Q',0,'Ammonia') + 0.05
x = 0.5
z = np.array([x, 1-x])
print(f'T={T:.4f} (Tsat_NH3(3MPa)+0.05)')

pa, pw = tp.Psat_pure(T)
print(f'Raoult: pa={pa:.4f} pw={pw:.5f} P_init={x*pa+(1-x)*pw:.4f} MPa')
# motor: bubbleP real
Pb, yb, ok = ng.bubbleP(T, x)
print(f'MOTOR: bubbleP({T:.3f},0.5)={Pb:.4f} MPa  y={yb:.5f}')

# seguimiento de mi flash
P = x*pa+(1-x)*pw; y = np.clip(x*pa/P, 1e-8, 1-1e-8)
for k in range(12):
    xl, xv = (z, np.array([y, 1-y]))
    try:
        rL = tp.rho_root(T, P*1e6, xl, 'l'); rV = tp.rho_root(T, P*1e6, xv, 'v')
        phiL = tp._MODEL.get_fugacity_coefficients(T, xl*rL)
        phiV = tp._MODEL.get_fugacity_coefficients(T, xv*rV)
        KA, KW = phiL[0]/phiV[0], phiL[1]/phiV[1]
    except Exception as e:
        print(f'  iter {k}: fallo {str(e)[:50]}'); break
    Pn = P*(x*KA+(1-x)*KW); yn = x*KA/(x*KA+(1-x)*KW)
    P = np.clip(0.6*P+0.4*Pn, 1e-8, 39.0); y = np.clip(0.6*y+0.4*yn, 1e-8, 1-1e-8)
    print(f'  iter {k}: P={P:8.4f} y={y:.5f} KA={KA:8.1f} KW={KW:7.4f} rhoL={rL:.0f} rhoV={rV:.1f}')
